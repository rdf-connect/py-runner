@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix rdfc: <https://w3id.org/rdf-connect#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.

rdfc:PySendProcessor rdfc:pyImplementationOf rdfc:Processor;
  rdfs:label "Send processor";
  rdfs:comment "Sends the configured string messages to a writer";
  rdfc:modulePath "echo_processor";
  rdfc:class "SendProcessor".

[ ] a sh:NodeShape;
  sh:targetClass rdfc:PySendProcessor;
  sh:property [
    sh:path rdfc:writer;
    sh:name "writer";
    sh:minCount 1;
    sh:maxCount 1;
    sh:class rdfc:Writer;
  ], [
    sh:path rdfc:msg;
    sh:name "msgs";
    sh:datatype xsd:string;
  ].

rdfc:PyEchoProcessor rdfc:pyImplementationOf rdfc:Processor;
  rdfs:label "Echo processor";
  rdfs:comment "Echoes every incoming message to a writer";
  rdfc:modulePath "echo_processor";
  rdfc:class "EchoProcessor".

[ ] a sh:NodeShape;
  sh:targetClass rdfc:PyEchoProcessor;
  sh:property [
    sh:path rdfc:reader;
    sh:name "reader";
    sh:minCount 1;
    sh:maxCount 1;
    sh:class rdfc:Reader;
  ], [
    sh:path rdfc:writer;
    sh:name "writer";
    sh:minCount 1;
    sh:maxCount 1;
    sh:class rdfc:Writer;
  ].

rdfc:PyLogProcessor rdfc:pyImplementationOf rdfc:Processor;
  rdfs:label "Log processor";
  rdfs:comment "Logs every incoming message";
  rdfc:modulePath "echo_processor";
  rdfc:class "LogProcessor".

[ ] a sh:NodeShape;
  sh:targetClass rdfc:PyLogProcessor;
  sh:property [
    sh:path rdfc:reader;
    sh:name "reader";
    sh:minCount 1;
    sh:maxCount 1;
    sh:class rdfc:Reader;
  ].
