@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdfc: <https://w3id.org/rdf-connect#>.

### Import the remote runner and its processors, served by the py-runner server.
<> owl:imports <http://localhost:3000/>,
  <http://localhost:3000/processors/send_processor.ttl>,
  <http://localhost:3000/processors/echo_processor.ttl>,
  <http://localhost:3000/processors/log_processor.ttl>.

<> a rdfc:Pipeline;
  rdfc:consistsOf [
    rdfc:processor <sendProc>, <echoProc>, <logProc>;
    rdfc:instantiates <http://localhost:3000/pyRunner>;
  ].

<sendProc> a rdfc:PySendProcessor;
  rdfc:msg "Hello", "World";
  rdfc:writer <raw>.

<echoProc> a rdfc:PyEchoProcessor;
  rdfc:reader <raw>;
  rdfc:writer <data>.

<logProc> a rdfc:PyLogProcessor;
  rdfc:reader <data>.
